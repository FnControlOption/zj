<idea-plugin>

  <!-- Unique id for this plugin. Must stay constant for the life of the plugin. -->
  <id>io.github.fncontroloption.zj</id>

  <!-- Text to display as name on Settings | Plugin page -->
  <name>ZJ</name>

  <!-- Product and plugin compatibility requirements -->
  <depends>com.intellij.modules.platform</depends>
  <incompatible-with>com.falsepattern.zigbrains</incompatible-with>

  <!-- Text to display as description on Settings | Plugin page -->
  <description>
    <![CDATA[
      Adds Zig language support to IntelliJ Platform-based IDEs
    ]]>
  </description>
  <!--
  <change-notes>
    <![CDATA[
      <ul>
        <li><b>2.0.0</b> Convert to Gradle-based plugin.</li>
        <li><b>1.0.0</b> Release 2018.3 and earlier.</li>
      </ul>
    ]]>
  </change-notes>
  -->

  <!-- Text to display as company information on Settings | Plugin page -->
  <vendor url="https://github.com/FnControlOption">fn ⌃ ⌥</vendor>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="ZIG" implementationClass="io.github.fncontroloption.zj.ZigFileType" fieldName="INSTANCE"
              language="ZIG" extensions="zig"/>
    <fileType name="ZON" implementationClass="io.github.fncontroloption.zj.ZonFileType" fieldName="INSTANCE"
              language="ZON" extensions="zon"/>
    <lang.parserDefinition language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigParserDefinition"/>
    <lang.parserDefinition language="ZON" implementationClass="io.github.fncontroloption.zj.ZonParserDefinition"/>
    <lang.parserDefinition language="ZIG_BUILTIN_FN_PROTO"
                           implementationClass="io.github.fncontroloption.zj.ZigBuiltinFnProtoParserDefinition"/>
    <lang.syntaxHighlighterFactory language="ZIG"
                                   implementationClass="io.github.fncontroloption.zj.ZigSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="io.github.fncontroloption.zj.ZigColorSettingsPage"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigHighlightAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigUnusedAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigUnderscoreIdentifierAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigUndeclaredIdentifierAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigUndeclaredLabelAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigDuplicateMembersAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigRedeclarationsAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigShadowAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigAmbiguousReferenceAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigLabelRedefinitionAnnotator"/>
    <externalAnnotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigAstCheckAnnotator"/>
    <externalAnnotator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigBuildAnnotator"/>
    <completion.contributor language="ZIG"
                            implementationClass="io.github.fncontroloption.zj.ZigCompletionContributor"/>
    <lang.findUsagesProvider language="ZIG"
                             implementationClass="io.github.fncontroloption.zj.ZigFindUsagesProvider"/>
    <lang.foldingBuilder language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigFoldingBuilder"/>
    <gotoSymbolContributor implementation="io.github.fncontroloption.zj.ZigChooseByNameContributor"/>
    <lang.psiStructureViewFactory language="ZIG"
                                  implementationClass="io.github.fncontroloption.zj.ZigStructureViewFactory"/>
    <lang.formatter language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigFormattingModelBuilder"/>
    <codeStyleSettingsProvider implementation="io.github.fncontroloption.zj.ZigCodeStyleSettingsProvider"/>
    <langCodeStyleSettingsProvider implementation="io.github.fncontroloption.zj.ZigLanguageCodeStyleSettingsProvider"/>
    <lang.commenter language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigCommenter"/>
    <platform.backend.documentation.psiTargetProvider
            implementation="io.github.fncontroloption.zj.ZigPsiDocumentationTargetProvider"/>
    <platform.backend.documentation.linkHandler
            implementation="io.github.fncontroloption.zj.ZigPsiDocumentationLinkHandler"/>
    <spellchecker.support language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigSpellcheckingStrategy"/>
    <lang.braceMatcher language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigBraceMatcher"/>
    <lang.quoteHandler language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigQuoteHandler"/>
    <projectConfigurable parentId="language"
                         instance="io.github.fncontroloption.zj.ZigSettingsConfigurable"
                         id="io.github.fncontroloption.zj.ZigSettingsConfigurable"
                         displayName="Zig"/>
    <!--
    <notificationGroup id="Zig" displayType="STICKY_BALLOON" hideFromSettings="true"/>
    -->
    <breadcrumbsInfoProvider implementation="io.github.fncontroloption.zj.ZigBreadcrumbsProvider"/>
    <languageStubDefinition language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigStubDefinition"/>
    <stubElementRegistryExtension implementation="io.github.fncontroloption.zj.ZigStubRegistryExtension"/>
    <stubIndex implementation="io.github.fncontroloption.zj.ZigContainerFieldStubIndex"/>
    <stubIndex implementation="io.github.fncontroloption.zj.ZigFnDeclStubIndex"/>
    <stubIndex implementation="io.github.fncontroloption.zj.ZigVarDeclStubIndex"/>
    <sdkType implementation="io.github.fncontroloption.zj.ZigSdkType"/>
    <projectSdkSetupValidator implementation="io.github.fncontroloption.zj.ZigProjectSdkSetupValidator"/>
    <sdkDownload implementation="io.github.fncontroloption.zj.ZigSdkDownload"/>
    <typedHandler implementation="io.github.fncontroloption.zj.ZigAutoPopupHandler" id="zigAuto" />
    <refactoring.elementListenerProvider implementation="io.github.fncontroloption.zj.ZigRefactoringListenerProvider"/>
    <codeInsight.parameterInfo language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigParameterInfoHandler"/>
    <codeInsight.typeInfo language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigExpressionTypeProvider"/>
    <additionalLibraryRootsProvider implementation="io.github.fncontroloption.zj.ZigLibraryRootsProvider"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigBuiltinProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigBuiltinFunctionsProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigModulesProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigBuildProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigExternalSystemProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigExeProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zj.ZigProjectPathActivity"/>
    <lang.namesValidator language="ZIG" implementationClass="io.github.fncontroloption.zj.ZigNamesValidator"/>
    <fileBasedIndex implementation="io.github.fncontroloption.zj.ZigEscapedIdentifierIndex"/>
    <fileBasedIndex implementation="io.github.fncontroloption.zj.ZigStringLiteralIndex"/>
    <referencesSearch implementation="io.github.fncontroloption.zj.ZigEscapedIdentifierReferencesSearch"/>
    <referencesSearch implementation="io.github.fncontroloption.zj.ZigModuleReferencesSearch"/>
    <vfs.asyncListenerBackgroundable implementation="io.github.fncontroloption.zj.ZigModulesAsyncFileListener"/>
    <vfs.asyncListenerBackgroundable implementation="io.github.fncontroloption.zj.ZigProjectPathFileListener"/>
    <directoryIndexExcludePolicy implementation="io.github.fncontroloption.zj.ZigDirectoryIndexExcludePolicy"/>
    <toolWindow id="Zig" anchor="bottom" icon="/icons/toolWindow.svg"
                factoryClass="io.github.fncontroloption.zj.ZigToolWindowFactory"/>
    <macro implementation="io.github.fncontroloption.zj.ZigBuildOptionsMacro"/>
    <configurationType implementation="io.github.fncontroloption.zj.ZigRunConfigurationType"/>
    <additionalTextAttributes scheme="Default" file="colorSchemes/ZigDefault.xml"/>
    <additionalTextAttributes scheme="Light" file="colorSchemes/ZigLight.xml"/>
    <additionalTextAttributes scheme="Dark" file="colorSchemes/ZigDark.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colorSchemes/ZigDarcula.xml"/>
    <additionalTextAttributes scheme="High contrast" file="colorSchemes/ZigHighContrast.xml"/>
    <highlightUsagesHandlerFactory implementation="io.github.fncontroloption.zj.ZigHighlightExitPointsHandlerFactory"/>
    <projectOpenProcessor implementation="io.github.fncontroloption.zj.ZigProjectOpenProcessor"/>
