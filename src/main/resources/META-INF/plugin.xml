    ]]>
  </change-notes>
  -->

  <!-- Text to display as company information on Settings | Plugin page -->
  <vendor url="https://github.com/FnControlOption">fn ⌃ ⌥</vendor>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="Zig" implementationClass="io.github.fncontroloption.zig.ZigFileType" fieldName="INSTANCE"
              language="Zig" extensions="zig"/>
    <lang.parserDefinition language="Zig" implementationClass="io.github.fncontroloption.zig.parser.ZigParserDefinition"/>
    <lang.syntaxHighlighterFactory language="Zig"
                                   implementationClass="io.github.fncontroloption.zig.syntaxHighlighter.ZigSyntaxHighlighterFactory"/>
    <highlightVisitor implementation="io.github.fncontroloption.zig.syntaxHighlighter.ZigHighlightVisitor"/>
    <colorSettingsPage implementation="io.github.fncontroloption.zig.syntaxHighlighter.ZigColorSettingsPage"/>
    <psi.referenceContributor language="Zig"
                              implementation="io.github.fncontroloption.zig.ZigReferenceContributor"/>
    <lang.foldingBuilder language="Zig" implementationClass="io.github.fncontroloption.zig.ZigFoldingBuilder"/>
    <codeStyleSettingsProvider implementation="io.github.fncontroloption.zig.codeStyle.ZigCodeStyleSettingsProvider"/>
    <langCodeStyleSettingsProvider implementation="io.github.fncontroloption.zig.codeStyle.ZigLanguageCodeStyleSettingsProvider"/>
    <lang.commenter language="Zig" implementationClass="io.github.fncontroloption.zig.ZigCommenter"/>
    <spellchecker.support language="Zig" implementationClass="io.github.fncontroloption.zig.ZigSpellcheckingStrategy"/>
    <lang.braceMatcher language="Zig" implementationClass="io.github.fncontroloption.zig.ZigBraceMatcher"/>
