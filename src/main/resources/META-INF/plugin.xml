<idea-plugin>

  <!-- Unique id for this plugin. Must stay constant for the life of the plugin. -->
  <id>io.github.fncontroloption.zig</id>

  <!-- Text to display as name on Settings | Plugin page -->
  <name>Zig Syntax Highlighter</name>

  <!-- Product and plugin compatibility requirements -->
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>

  <!-- Text to display as description on Settings | Plugin page -->
  <!--
  <description>
    <![CDATA[
      Demonstrates how to add custom language support to an IntelliJ Platform-based IDE. <br>Defines a new language,
      <i>Simple language</i> with support for syntax highlighting, annotations, code completion, and other features.
      <br>
      See the
      <a href="https://plugins.jetbrains.com/docs/intellij/custom-language-support-tutorial.html">Custom
      Language Tutorial</a> for more information.
    ]]>
  </description>
  <change-notes>
    <![CDATA[
      <ul>
        <li><b>2.0.0</b> Convert to Gradle-based plugin.</li>
        <li><b>1.0.0</b> Release 2018.3 and earlier.</li>
      </ul>
    ]]>
  </change-notes>
  -->

  <!-- Text to display as company information on Settings | Plugin page -->
  <vendor url="https://github.com/FnControlOption">fn ⌃ ⌥</vendor>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="ZIG" implementationClass="io.github.fncontroloption.zig.ZigFileType" fieldName="INSTANCE"
              language="ZIG" extensions="zig"/>
    <fileType name="ZON" implementationClass="io.github.fncontroloption.zig.ZonFileType" fieldName="INSTANCE"
              language="ZON" extensions="zon"/>
    <lang.parserDefinition language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigParserDefinition"/>
    <lang.parserDefinition language="ZON" implementationClass="io.github.fncontroloption.zig.ZonParserDefinition"/>
    <lang.parserDefinition language="ZIG_BUILTIN_FN_PROTO"
                           implementationClass="io.github.fncontroloption.zig.ZigBuiltinFnProtoParserDefinition"/>
    <lang.syntaxHighlighterFactory language="ZIG"
                                   implementationClass="io.github.fncontroloption.zig.ZigSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="io.github.fncontroloption.zig.ZigColorSettingsPage"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigHighlightAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigUnusedAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigUnderscoreIdentifierAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigUndeclaredIdentifierAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigUndeclaredLabelAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigDuplicateMembersAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigRedeclarationsAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigShadowAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigAmbiguousReferenceAnnotator"/>
    <annotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigLabelRedefinitionAnnotator"/>
    <externalAnnotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigAstCheckAnnotator"/>
    <externalAnnotator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigBuildAnnotator"/>
    <completion.contributor language="ZIG"
                            implementationClass="io.github.fncontroloption.zig.ZigCompletionContributor"/>
    <lang.findUsagesProvider language="ZIG"
                             implementationClass="io.github.fncontroloption.zig.ZigFindUsagesProvider"/>
    <lang.foldingBuilder language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigFoldingBuilder"/>
    <gotoSymbolContributor implementation="io.github.fncontroloption.zig.ZigChooseByNameContributor"/>
    <lang.psiStructureViewFactory language="ZIG"
                                  implementationClass="io.github.fncontroloption.zig.ZigStructureViewFactory"/>
    <lang.formatter language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigFormattingModelBuilder"/>
    <codeStyleSettingsProvider implementation="io.github.fncontroloption.zig.ZigCodeStyleSettingsProvider"/>
    <langCodeStyleSettingsProvider implementation="io.github.fncontroloption.zig.ZigLanguageCodeStyleSettingsProvider"/>
    <lang.commenter language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigCommenter"/>
    <platform.backend.documentation.psiTargetProvider
            implementation="io.github.fncontroloption.zig.ZigPsiDocumentationTargetProvider"/>
    <platform.backend.documentation.linkHandler
            implementation="io.github.fncontroloption.zig.ZigPsiDocumentationLinkHandler"/>
    <spellchecker.support language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigSpellcheckingStrategy"/>
    <lang.braceMatcher language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigBraceMatcher"/>
    <lang.quoteHandler language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigQuoteHandler"/>
    <projectConfigurable parentId="language"
                         instance="io.github.fncontroloption.zig.ZigSettingsConfigurable"
                         id="io.github.fncontroloption.zig.ZigSettingsConfigurable"
                         displayName="Zig"/>
    <!--
    <notificationGroup id="Zig" displayType="STICKY_BALLOON" hideFromSettings="true"/>
    -->
    <breadcrumbsInfoProvider implementation="io.github.fncontroloption.zig.ZigBreadcrumbsProvider"/>
    <languageStubDefinition language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigStubDefinition"/>
    <stubElementRegistryExtension implementation="io.github.fncontroloption.zig.ZigStubRegistryExtension"/>
    <stubIndex implementation="io.github.fncontroloption.zig.ZigContainerFieldStubIndex"/>
    <stubIndex implementation="io.github.fncontroloption.zig.ZigFnDeclStubIndex"/>
    <stubIndex implementation="io.github.fncontroloption.zig.ZigVarDeclStubIndex"/>
    <sdkType implementation="io.github.fncontroloption.zig.ZigSdkType"/>
    <projectSdkSetupValidator implementation="io.github.fncontroloption.zig.ZigProjectSdkSetupValidator"/>
    <typedHandler implementation="io.github.fncontroloption.zig.ZigAutoPopupHandler" id="zigAuto" />
    <refactoring.elementListenerProvider implementation="io.github.fncontroloption.zig.ZigRefactoringListenerProvider"/>
    <codeInsight.parameterInfo language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigParameterInfoHandler"/>
    <codeInsight.typeInfo language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigExpressionTypeProvider"/>
    <additionalLibraryRootsProvider implementation="io.github.fncontroloption.zig.ZigLibraryRootsProvider"/>
    <postStartupActivity implementation="io.github.fncontroloption.zig.ZigBuiltinProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zig.ZigBuiltinFunctionsProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zig.ZigModulesProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zig.ZigBuildProjectActivity"/>
    <postStartupActivity implementation="io.github.fncontroloption.zig.ZigExternalSystemProjectActivity"/>
    <lang.namesValidator language="ZIG" implementationClass="io.github.fncontroloption.zig.ZigNamesValidator"/>
    <fileBasedIndex implementation="io.github.fncontroloption.zig.ZigEscapedIdentifierIndex"/>
    <referencesSearch implementation="io.github.fncontroloption.zig.ZigEscapedIdentifierReferencesSearch"/>
    <vfs.asyncListenerBackgroundable implementation="io.github.fncontroloption.zig.ZigModulesAsyncFileListener"/>
    <directoryIndexExcludePolicy implementation="io.github.fncontroloption.zig.ZigDirectoryIndexExcludePolicy"/>
    <toolWindow id="Zig" anchor="bottom" icon="/icons/toolWindow.svg"
                factoryClass="io.github.fncontroloption.zig.ZigToolWindowFactory"/>
